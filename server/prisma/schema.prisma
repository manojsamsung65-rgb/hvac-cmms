// Prisma schema. Migrations are versioned in prisma/migrations and applied only
// in CI (ephemeral Postgres) or a future managed database - never to an external
// database from this environment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  fullName       String
  passwordHash   String?
  isActive       Boolean  @default(true)
  isSuperAdmin   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  sessions      Session[]
  userRoles     UserRole[]
  mfaFactors    MfaFactor[]
  recoveryCodes RecoveryCode[]

  @@unique([organizationId, id])
  @@unique([email])
  @@index([organizationId])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id                String    @id @default(uuid())
  organizationId    String
  userId            String
  tokenHash         String    @unique
  csrfToken         String
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  lastUsedAt        DateTime?
  mfaVerifiedAt     DateTime?
  revokedAt         DateTime?
  ip                String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])

  @@index([userId])
  @@map("sessions")
}

model MfaFactor {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  type           String    @default("totp")
  secret         String
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])

  @@unique([userId, type])
  @@index([userId])
  @@map("mfa_factors")
}

model RecoveryCode {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  codeHash       String    @unique
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])

  @@index([userId])
  @@map("recovery_codes")
}
