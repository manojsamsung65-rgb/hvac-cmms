// Prisma schema. Migrations are versioned in prisma/migrations and applied only
// in CI (ephemeral Postgres) or a future managed database - never to an external
// database from this environment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  fullName       String
  passwordHash   String?
  isActive       Boolean  @default(true)
  isSuperAdmin   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  sessions      Session[]
  userRoles     UserRole[]
  mfaFactors    MfaFactor[]
  recoveryCodes RecoveryCode[]

  @@unique([organizationId, id])
  @@unique([email])
  @@index([organizationId])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id                String    @id @default(uuid())
  organizationId    String
  userId            String
  tokenHash         String    @unique
  csrfToken         String
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  lastUsedAt        DateTime?
  mfaVerifiedAt     DateTime?
  revokedAt         DateTime?
  ip                String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])

  @@index([userId])
  @@map("sessions")
}

model MfaFactor {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  type           String    @default("totp")
  secret         String
  verifiedAt     DateTime?
  lastTotpStep   Int?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])

  @@unique([userId, type])
  @@index([userId])
  @@map("mfa_factors")
}

model RecoveryCode {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  codeHash       String    @unique
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])

  @@index([userId])
  @@map("recovery_codes")
}

enum Criticality {
  low
  medium
  high
  critical
}

enum EquipmentStatus {
  active
  inactive
  under_maintenance
  retired
}

// Minimal supporting tables so equipment foreign keys are real and tenant-safe.
// Full Site/Building CRUD is a later module; only create/list is exposed here.
model Site {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  buildings Building[]
  equipment Equipment[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("sites")
}

model Building {
  id             String   @id @default(uuid())
  organizationId String
  siteId         String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Composite FK: the site must belong to the same organisation.
  site      Site        @relation(fields: [organizationId, siteId], references: [organizationId, id])
  equipment Equipment[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, siteId])
  @@map("buildings")
}

model Equipment {
  id                String          @id @default(uuid())
  organizationId    String
  code              String
  name              String
  category          String
  siteId            String?
  buildingId        String?
  location          String?
  manufacturer      String?
  model             String?
  serialNumber      String?
  criticality       Criticality     @default(medium)
  status            EquipmentStatus @default(active)
  commissioningDate DateTime?       @db.Date
  warrantyProvider  String?
  warrantyStart     DateTime?       @db.Date
  warrantyEnd       DateTime?       @db.Date
  maintenanceNotes  String?
  deletedAt         DateTime?
  createdBy         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Composite FKs: a referenced site/building must belong to the same organisation.
  site     Site?     @relation(fields: [organizationId, siteId], references: [organizationId, id])
  building Building? @relation(fields: [organizationId, buildingId], references: [organizationId, id])

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, siteId])
  @@map("equipment")
}

// Append-only audit trail. Written server-side inside the same transaction as the
// change it records; there is no API to update or delete these rows.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}
