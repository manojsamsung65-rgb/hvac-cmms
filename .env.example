# Frontend environment variable NAMES only. Never commit real values.
# The frontend must never hold secrets (no database credentials, no keys).

# API base URL (used once the frontend API client replaces the Supabase client):
VITE_API_BASE_URL=http://localhost:4000

# Supabase placeholders are RETAINED until the frontend API client is implemented
# and tested; they will be removed in a later milestone, not blindly.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The API server has its own environment file: see server/.env.example
